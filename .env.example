# Copy this file to .env and fill in your values:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)
# .env is git-ignored; this template is safe to commit.

# LLM - Groq API key (Groq, not xAI Grok). Get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# Chat model - change this if Groq retires it (list: https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents
# Optional: Qdrant Cloud cluster instead of a local server (overrides host/port)
# QDRANT_URL=https://<id>.<region>.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_cloud_key

# UI - optional password the app asks for before opening (for public deployments)
# APP_PASSWORD=choose_a_password

# Embeddings (local sentence-transformers model, 384-dim)
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# Retrieval - passages less similar than this (cosine, 0-1) never reach the LLM.
# Raise it (e.g. 0.25) to be stricter; lower it if real questions return "couldn't find".
MIN_RELEVANCE=0.15
